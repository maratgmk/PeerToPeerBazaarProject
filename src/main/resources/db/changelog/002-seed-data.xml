    <!-- 018: Insert sample part offer to buy (for the seller offer) -->
    <changeSet id="018-part-offer-to-buy" author="your-name" runOnChange="true" failOnError="false">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="part_offer_to_buy"/>
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM part_offer_to_buy</sqlCheck>
        </preConditions>
        <insert tableName="part_offer_to_buy">
            <column name="id" value="1"/>
            <column name="status" value="NOT_RESERVED"/>
            <column name="seller_offer_id" valueNumeric="1"/>
            <!-- buyer_order_id опущен: вставится NULL по умолчанию (nullable=true), обновится в 022 -->
            <column name="created_at" valueDate="2025-09-23 13:00:00"/>
        </insert>
    </changeSet>

    <!-- 019: Insert baskets for buyers -->
    <changeSet id="019-baskets" author="your-name" runOnChange="true" failOnError="false">
        <preConditions onFail="MARK_RAN">
