        </insert>
    </changeSet>

    <!-- 022: Insert sample buyer order for buyer1 (с UPDATE для связи с part_offer_to_buy) -->
    <changeSet id="022-buyer-order" author="your-name" runOnChange="true" failOnError="false">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="buyer_order"/>
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM buyer_order</sqlCheck>
            <!-- Проверка: part_offer_to_buy существует для UPDATE -->
            <tableExists tableName="part_offer_to_buy"/>
            <sqlCheck expectedResult="1">SELECT COUNT(*) FROM part_offer_to_buy WHERE id = 1</sqlCheck>
        </preConditions>
        <!-- Вставка заказа покупателя -->
        <insert tableName="buyer_order">
            <column name="id" value="1"/>
            <column name="buyer_order_status" value="PLACED"/>
            <column name="buyer_id" valueNumeric="2"/>  <!-- Покупатель Alice (ID=2) -->
            <column name="payment_id" valueNumeric="1"/>  <!-- Платёж из 021 -->
            <column name="created_at" valueDate="2025-09-23 13:50:00"/>
        </insert>
        <!-- UPDATE: Связываем part_offer_to_buy с заказом (завершаем цикл) -->
        <update tableName="part_offer_to_buy">
            <column name="buyer_order_id" valueNumeric="1"/>  <!-- Реальная связь с заказом -->
            <column name="status" value="RESERVED"/>  <!-- Обновляем статус: зарезервировано под заказ -->
            <where>id = 1</where>  <!-- Только для части из 018 (Alice; Bob остаётся NOT_RESERVED) -->
        </update>
    </changeSet>

    <!-- 023: Insert sample delivery for the order (восстановленный полный) -->
    <changeSet id="023-delivery" author="your-name" runOnChange="true" failOnError="false">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="delivery"/>
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM delivery</sqlCheck>
        </preConditions>
        <insert tableName="delivery">
            <column name="id" value="1"/>
            <column name="delivery_status" value="SCHEDULED"/>
            <column name="start_slot" valueDate="2025-09-23 15:00:00"/>
            <column name="end_slot" valueDate="2025-09-23 16:00:00"/>
            <column name="buyer_order_id" valueNumeric="1"/>  <!-- Ссылка на заказ из 022 -->
            <column name="to_address_id" valueNumeric="2"/>   <!-- Адрес Alice -->
            <column name="from_address_id" valueNumeric="1"/> <!-- Адрес продавца -->
            <column name="drone_id" valueNumeric="1"/>        <!-- Дрон из 015 -->
            <column name="created_at" valueDate="2025-09-23 14:00:00"/>
        </insert>
    </changeSet>

</databaseChangeLog>
